# Copy to .env in the repo root (or backend/.env for some setups). Do not commit .env.

# --- Profile ---
# local = lab TLS on 8443, optional H2 file DB
# deploy = PostgreSQL + env-only secrets (use on a hosted server)
SPRING_PROFILES_ACTIVE=local

# --- Public URL (must match what Windows devices and browsers use) ---
SERVER_PORT=8443
PUBLIC_BASE_URL=https://192.168.1.20:8443

# --- Admin UI / management API (Bearer token) ---
# Set a long random value in production. Anyone with this token can create enrollment tokens and policies.
# If unset locally, the server writes backend/data/admin-token on first start.
APPLOCKER_ADMIN_TOKEN=

# Set false when TLS terminates at a reverse proxy (nginx, Caddy, cloud load balancer).
APPLOCKER_LAB_TLS=true

# --- Database (deploy profile) ---
# Leave unset for local H2 under backend/data/applocker.
# DATABASE_URL=jdbc:postgresql://localhost:5432/applocker
# DATABASE_USERNAME=applocker
# DATABASE_PASSWORD=

# --- Optional: Docker Postgres from project compose (often host port 5433) ---
# DATABASE_URL=jdbc:postgresql://localhost:5433/applocker
# DATABASE_USERNAME=applocker
# DATABASE_PASSWORD=applocker